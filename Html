<section class="portfolio-section" id="portfolio">
  <div class="portfolio-container">

    <div class="portfolio-header">
      <div>
        <span class="portfolio-label">SELECTED WORK</span>
        <h2>Stories through <em>my lens.</em></h2>
      </div>

      <p>
        A curated collection of portraits, celebrations, landscapes
        and meaningful moments captured with creativity and emotion.
      </p>
    </div>

    <!-- FILTERS -->
    <div class="portfolio-filters">
      <button class="portfolio-filter active" data-filter="all">All</button>
      <button class="portfolio-filter" data-filter="portrait">Portraits</button>
      <button class="portfolio-filter" data-filter="wedding">Weddings</button>
      <button class="portfolio-filter" data-filter="event">Events</button>
      <button class="portfolio-filter" data-filter="landscape">Landscapes</button>
    </div>

    <!-- GALLERY -->
    <div class="studio-gallery">

      <!-- Featured image -->
      <div class="studio-item studio-large portrait">
        <img
          src="images/portrait-01.jpg"
          alt="Professional portrait photography"
          loading="lazy"
        >

        <div class="studio-caption">
          <span>PORTRAIT</span>
          <h3>Natural Light</h3>
        </div>
      </div>

      <!-- Landscape -->
      <div class="studio-item studio-wide landscape">
        <img
          src="images/landscape-01.jpg"
          alt="Landscape photography"
          loading="lazy"
        >

        <div class="studio-caption">
          <span>LANDSCAPE</span>
          <h3>Into the Wild</h3>
        </div>
      </div>

      <!-- Wedding -->
      <div class="studio-item wedding">
        <img
          src="images/wedding-01.jpg"
          alt="Wedding photography"
          loading="lazy"
        >

        <div class="studio-caption">
          <span>WEDDING</span>
          <h3>Forever Together</h3>
        </div>
      </div>

      <!-- Event -->
      <div class="studio-item event">
        <img
          src="images/event-01.jpg"
          alt="Event photography"
          loading="lazy"
        >

        <div class="studio-caption">
          <span>EVENT</span>
          <h3>The Celebration</h3>
        </div>
      </div>

      <!-- Portrait -->
      <div class="studio-item studio-wide portrait">
        <img
          src="images/portrait-02.jpg"
          alt="Creative portrait photography"
          loading="lazy"
        >

        <div class="studio-caption">
          <span>PORTRAIT</span>
          <h3>Character</h3>
        </div>
      </div>

      <!-- Landscape -->
      <div class="studio-item studio-tall landscape">
        <img
          src="images/landscape-02.jpg"
          alt="Mountain landscape photography"
          loading="lazy"
        >

        <div class="studio-caption">
          <span>LANDSCAPE</span>
          <h3>Golden Hour</h3>
        </div>
      </div>

      <!-- Wedding -->
      <div class="studio-item wedding">
        <img
          src="images/wedding-02.jpg"
          alt="Wedding couple photography"
          loading="lazy"
        >

        <div class="studio-caption">
          <span>WEDDING</span>
          <h3>Moments Together</h3>
        </div>
      </div>

      <!-- Event -->
      <div class="studio-item event">
        <img
          src="images/event-02.jpg"
          alt="Celebration event photography"
          loading="lazy"
        >

        <div class="studio-caption">
          <span>EVENT</span>
          <h3>Unforgettable Night</h3>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- FULLSCREEN LIGHTBOX -->
<div class="gallery-lightbox" id="galleryLightbox">

  <button class="lightbox-close" id="lightboxClose">
    &times;
  </button>

  <button class="lightbox-prev" id="lightboxPrev">
    &#10094;
  </button>

  <img id="lightboxImage" src="" alt="">

  <button class="lightbox-next" id="lightboxNext">
    &#10095;
  </button>

  <div class="lightbox-title" id="lightboxTitle"></div>

</div>
